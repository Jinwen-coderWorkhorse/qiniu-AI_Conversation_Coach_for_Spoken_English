# =============================================================================
# AI 英语口语陪练 MVP — 本地开发环境变量模板
# 复制为 .env 后按需修改；勿将真实密钥提交到版本库。
# 依赖服务启动：见 docs/联调记录/E-02-本地依赖环境启动说明.md
# =============================================================================

# --- 应用基础 ---
APP_NAME=AI Conversation Coach API
API_V1_PREFIX=/api/v1

# --- 数据库（对接 infra/docker-compose.yml 中的 MySQL）---
# 工程师 A 接入 MySQL 后需安装驱动，例如 pymysql：
# DATABASE_URL=mysql+pymysql://coach:coach_dev@127.0.0.1:3306/conversation_coach?charset=utf8mb4
DATABASE_URL=mysql+pymysql://coach:coach_dev@127.0.0.1:3306/conversation_coach?charset=utf8mb4

# --- 消息队列（对接 infra/docker-compose.yml 中的 RabbitMQ）---
RABBITMQ_URL=amqp://coach:coach_dev@127.0.0.1:5672/
# MVP mock 阶段报告任务默认同步执行；接入 Celery 后改为 async
REPORT_WORKER_MODE=sync

# --- 鉴权 ---
JWT_SECRET=dev-only-change-me-before-production
JWT_ALGORITHM=HS256
JWT_EXPIRES_SECONDS=604800

# --- 对象存储 / MinIO（对接 infra/docker-compose.yml 中的 MinIO）---
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=conversation-coach-media
# 私有 bucket 场景下通常留空；若配置 CDN / 公网网关再填写
S3_PUBLIC_BASE_URL=

# --- AI Provider（MVP 默认 mock，无需真实 API Key）---
AI_PROVIDER=mock
ASR_PROVIDER=
TTS_PROVIDER=
LLM_API_KEY=
ASR_API_KEY=
TTS_API_KEY=
PROVIDER_MAX_RETRIES=2

# --- 业务限流与媒体约束（与 docs/详细设计/07-公共基础组件详细设计.md 一致）---
MAX_DAILY_SESSIONS_PER_USER=20
MAX_DAILY_USER_TURNS_PER_USER=120
MAX_SESSION_MINUTES=10
MAX_AUDIO_UPLOAD_MB=20
MAX_AUDIO_DURATION_SECONDS=60

# --- 本地媒体兜底目录（未接 S3/MinIO 时使用）---
MEDIA_LOCAL_ROOT=apps/api/tmp/media

# --- Mock Provider 调试开关（可选）---
# MOCK_ASR_LOW_CONFIDENCE=false
# MOCK_TTS_HAS_AUDIO=true

# --- 前端（apps/web）---
# 开发时若 API 与 Web 不同源，指向 FastAPI 地址，例如 http://127.0.0.1:8000/api/v1
NEXT_PUBLIC_API_BASE_URL=/api/v1
